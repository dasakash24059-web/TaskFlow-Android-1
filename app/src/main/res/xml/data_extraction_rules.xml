<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Only back up non-sensitive UI theme preferences; exclude auth, App Check, and cached APKs -->
        <include domain="sharedpref" path="taskflow_theme_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="taskflow_theme_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
