rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAdmin() {
      return isSignedIn() && (
        (('admin' in request.auth.token) && request.auth.token.admin == true) ||
        (
          ('email' in request.auth.token) &&
          request.auth.token.email.lower() == 'dasakash24059@gmail.com' &&
          ('email_verified' in request.auth.token) &&
          request.auth.token.email_verified == true
        )
      );
    }

    // Proof images uploaded for task submissions:
    // Path: /submissions/{userId}/{taskId}/{fileName}
    //
    // Phase F.3 Zero-Trust Server-Mediated Upload Policy:
    // 1. Direct client uploads, overwrites, and deletions via Firebase Storage SDK / REST bearer tokens
    //    are strictly denied (`allow create, update, delete: if false;`).
    // 2. Uploads occur exclusively via short-lived, create-only (`x-goog-if-generation-match: 0`)
    //    server-issued upload tickets (`issueTaskProofUploadTicket`) and are verified and committed
    //    by `finalizeTaskProofSubmission` after verifying `approvalStatus == 'approved'` in the named
    //    Firestore database.
    // 3. Reads are permitted exclusively for the verified submitting user (`request.auth.uid == userId`)
    //    and verified Admins (`isVerifiedAdmin()`) for Admin Proof Review, preserving historical proof reads.
    match /submissions/{userId}/{taskId}/{fileName} {
      allow read: if isSignedIn() && (
                     (
                       request.auth.uid == userId &&
                       ('email_verified' in request.auth.token) &&
                       request.auth.token.email_verified == true
                     ) ||
                     isVerifiedAdmin()
                   );
      allow create, update, delete: if false;
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
