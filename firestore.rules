rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. GLOBAL SECURITY & VALIDATION PRIMITIVES
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function changedKeys() {
      return incoming().diff(existing()).affectedKeys();
    }

    function hasExactKeys(allowedKeys) {
      return incoming().keys().hasOnly(allowedKeys) &&
             incoming().keys().hasAll(allowedKeys);
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    function isOptionalString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isValidHttpsTaskLink(val) {
      return val is string &&
             val.size() <= 1000 &&
             (val == '' || val.matches('^https://[^\\s]+\\.[^\\s]+.*$'));
    }

    function isValidIconOrImageField(val) {
      return val is string &&
             val.size() <= 350000 &&
             (
               val == '' ||
               val.matches('^https://[^\\s]+\\.[^\\s]+.*$') ||
               val.matches('^data:image/[a-zA-Z0-9.+-]+;base64,[a-zA-Z0-9+/=]+$')
             );
    }

    function isValidProofImageUrl(val) {
      return val is string &&
             val.size() > 0 &&
             val.size() <= 350000 &&
             (
               val.matches('^https://[^\\s]+\\.[^\\s]+.*$') ||
               val.matches('^data:image/[a-zA-Z0-9.+-]+;base64,[a-zA-Z0-9+/=]+$')
             );
    }

    // Bootstrapped Owner / Admin email check with mandatory verified email token claim
    function isBootstrappedAdmin() {
      return isSignedIn() &&
             ('email' in request.auth.token) &&
             request.auth.token.email == 'dasakash24059@gmail.com' &&
             ('email_verified' in request.auth.token) &&
             request.auth.token.email_verified == true;
    }

    // Secure Admin verification:
    // Checks custom token claim `admin == true`, verified bootstrap owner email,
    // or existence of `/admins/$(request.auth.uid)` document.
    // NEVER trusts client-editable `/users/{uid}.role`.
    function isAdmin() {
      return isSignedIn() && (
        (('admin' in request.auth.token) && request.auth.token.admin == true) ||
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Strict Approved User check:
    // ONLY users with `approvalStatus == 'approved'` are permitted to perform
    // approved-user-only operations (submitting task proofs, creating withdrawal requests).
    // Pending (`pending`) and suspended (`suspended`) users are strictly blocked.
    function isApprovedUser(uid) {
      let userPath = /databases/$(database)/documents/users/$(uid);
      return exists(userPath) &&
             get(userPath).data.approvalStatus == 'approved';
    }

    // =========================================================================
    // 2. USER PROFILE VALIDATION (/users/{userId})
    // =========================================================================

    function isValidUserCreate(userId) {
      let isBootstrap = isBootstrappedAdmin();
      let hasVerifiedEmail = ('email_verified' in request.auth.token) &&
                             request.auth.token.email_verified == true;
      return incoming().keys().hasOnly([
               'userId',
               'email',
               'displayName',
               'role',
               'approvalStatus',
               'balanceCents',
               'virtualPoints',
               'completedTasksCount',
               'assignedTaskId',
               'createdAt',
               'updatedAt'
             ]) &&
             incoming().keys().hasAll([
               'userId',
               'email',
               'displayName',
               'role',
               'approvalStatus',
               'balanceCents',
               'completedTasksCount',
               'assignedTaskId',
               'createdAt',
               'updatedAt'
             ]) &&
             hasVerifiedEmail &&
             incoming().userId == userId &&
             isNonEmptyString(incoming().email, 254) &&
             isNonEmptyString(incoming().displayName, 100) &&
             incoming().balanceCents is int &&
             incoming().balanceCents == 0 &&
             (!('virtualPoints' in incoming()) || (incoming().virtualPoints is int && incoming().virtualPoints == 0)) &&
             incoming().completedTasksCount is int &&
             incoming().completedTasksCount == 0 &&
             incoming().assignedTaskId == '' &&
             incoming().createdAt is timestamp &&
             incoming().updatedAt is timestamp &&
             (
               (isBootstrap && incoming().role == 'admin' && incoming().approvalStatus == 'approved') ||
               (!isBootstrap && incoming().role == 'user' && incoming().approvalStatus == 'pending')
             );
    }

    // Regular user can ONLY update their own displayName and updatedAt.
    // All client-side modifications to balanceCents, role, approvalStatus, checkInStreak,
    // or lastCheckInDate are strictly prohibited.
    function isValidOwnerDisplayNameUpdate(userId) {
      return request.auth.uid == userId &&
             changedKeys().hasOnly(['displayName', 'updatedAt']) &&
             isNonEmptyString(incoming().displayName, 100) &&
             incoming().balanceCents == existing().balanceCents &&
             incoming().role == existing().role &&
             incoming().approvalStatus == existing().approvalStatus &&
             incoming().updatedAt is timestamp;
    }

    // Bootstrapped admin self-elevation if profile was created before bootstrap check
    function isBootstrapAdminSelfInit(userId) {
      return isBootstrappedAdmin() &&
             request.auth.uid == userId &&
             changedKeys().hasOnly(['role', 'approvalStatus', 'updatedAt']) &&
             incoming().role == 'admin' &&
             incoming().approvalStatus == 'approved' &&
             incoming().balanceCents == existing().balanceCents &&
             incoming().updatedAt is timestamp;
    }

    // Admin updating a user's approvalStatus ('pending', 'approved', 'suspended')
    function isValidAdminUserStatusUpdate() {
      return isAdmin() &&
             changedKeys().hasOnly(['approvalStatus', 'updatedAt']) &&
             (
               incoming().approvalStatus == 'approved' ||
               incoming().approvalStatus == 'pending' ||
               incoming().approvalStatus == 'suspended'
             ) &&
             incoming().balanceCents == existing().balanceCents &&
             incoming().updatedAt is timestamp;
    }

    // Admin updating a user's displayName
    function isValidAdminDisplayNameUpdate() {
      return isAdmin() &&
             changedKeys().hasOnly(['displayName', 'updatedAt']) &&
             isNonEmptyString(incoming().displayName, 100) &&
             incoming().balanceCents == existing().balanceCents &&
             incoming().updatedAt is timestamp;
    }

    function isTaskAssignedToUserAfter(taskId, userId) {
      let taskPath = /databases/$(database)/documents/tasks/$(taskId);
      return existsAfter(taskPath) &&
             getAfter(taskPath).data.assignedUserId == userId;
    }

    // Admin assigning a task to a user atomically during task creation or reassignment
    function isAtomicTaskAssignmentToUser(userId) {
      return isAdmin() &&
             changedKeys().hasOnly(['assignedTaskId', 'updatedAt']) &&
             isNonEmptyString(incoming().assignedTaskId, 128) &&
             incoming().updatedAt is timestamp &&
             incoming().balanceCents == existing().balanceCents &&
             isTaskAssignedToUserAfter(incoming().assignedTaskId, userId);
    }

    function isTaskUnassignedFromUserAfter(prevTaskId, userId) {
      let taskPath = /databases/$(database)/documents/tasks/$(prevTaskId);
      return !existsAfter(taskPath) ||
             getAfter(taskPath).data.assignedUserId != userId;
    }

    // Admin clearing a user's assignedTaskId atomically when task is reassigned or deleted
    function isAtomicTaskUnassignmentFromUser(userId) {
      return isAdmin() &&
             changedKeys().hasOnly(['assignedTaskId', 'updatedAt']) &&
             isNonEmptyString(existing().assignedTaskId, 128) &&
             incoming().assignedTaskId == '' &&
             incoming().updatedAt is timestamp &&
             incoming().balanceCents == existing().balanceCents &&
             isTaskUnassignedFromUserAfter(existing().assignedTaskId, userId);
    }

    function isTaskAndSubmissionApprovedForUser(taskId, userId) {
      let taskPath = /databases/$(database)/documents/tasks/$(taskId);
      let legacySubPath = /databases/$(database)/documents/submissions/$(taskId);
      let multiSubPath = /databases/$(database)/documents/submissions/$(taskId + '_' + userId);
      let subPath = existsAfter(multiSubPath) ? multiSubPath : legacySubPath;
      return exists(taskPath) &&
             exists(subPath) &&
             existsAfter(taskPath) &&
             existsAfter(subPath) &&
             get(taskPath).data.status == 'submitted' &&
             getAfter(taskPath).data.status == 'approved' &&
             get(subPath).data.status == 'submitted' &&
             getAfter(subPath).data.status == 'approved' &&
             getAfter(subPath).data.userId == userId &&
             getAfter(taskPath).data.assignedUserId == userId &&
             incoming().balanceCents == existing().balanceCents + get(taskPath).data.rewardCents &&
             incoming().completedTasksCount == existing().completedTasksCount + 1;
    }

    // Admin crediting a user's wallet as part of an atomic task + submission approval batch
    function isAtomicTaskApprovalForUser(userId) {
      return isAdmin() &&
             changedKeys().hasOnly(['balanceCents', 'balanceCoins', 'eligibleCoins', 'completedTasksCount', 'assignedTaskId', 'updatedAt']) &&
             isNonEmptyString(incoming().assignedTaskId, 128) &&
             incoming().updatedAt is timestamp &&
             isTaskAndSubmissionApprovedForUser(incoming().assignedTaskId, userId);
    }

    // Approved user updating promotional Coin balance or Spin/Check-in state atomically
    // Never allows modifying balanceCents, eligibleCoins, role, approvalStatus, or completedTasksCount.
    function isAtomicPromotionalCoinOrSpinUpdate(userId) {
      let oldPromo = ('promotionalCoins' in existing() && existing().promotionalCoins is int) ? existing().promotionalCoins : 0;
      let newPromo = ('promotionalCoins' in incoming() && incoming().promotionalCoins is int) ? incoming().promotionalCoins : oldPromo;
      let promoDelta = newPromo - oldPromo;
      let oldBalanceCents = ('balanceCents' in existing() && existing().balanceCents is int) ? existing().balanceCents : 0;
      let oldCentsCoins = int((oldBalanceCents * 125) / 100);
      let oldEligible = ('eligibleCoins' in existing() && existing().eligibleCoins is int && existing().eligibleCoins > oldCentsCoins)
        ? existing().eligibleCoins
        : oldCentsCoins;
      let oldBalanceCoins = ('balanceCoins' in existing() && existing().balanceCoins is int && existing().balanceCoins > (oldEligible + oldPromo))
        ? existing().balanceCoins
        : (oldEligible + oldPromo);
      return request.auth.uid == userId &&
             isApprovedUser(userId) &&
             incoming().balanceCents == existing().balanceCents &&
             incoming().role == existing().role &&
             incoming().approvalStatus == existing().approvalStatus &&
             incoming().completedTasksCount == existing().completedTasksCount &&
             changedKeys().hasOnly([
               'balanceCoins',
               'promotionalCoins',
               'lastCheckInDate',
               'checkInStreak',
               'lastCheckInTimestamp',
               'lastFreeSpinAt',
               'extraSpinVideosWatched',
               'extraSpinAvailable',
               'updatedAt'
             ]) &&
             promoDelta >= 0 &&
             promoDelta <= 1000 &&
             (
               (!('balanceCoins' in existing()) && promoDelta == 0 && !('balanceCoins' in changedKeys())) ||
               (('balanceCoins' in incoming()) && incoming().balanceCoins is int && incoming().balanceCoins == oldBalanceCoins + promoDelta)
             ) &&
             (!('extraSpinVideosWatched' in incoming()) || (incoming().extraSpinVideosWatched is int && incoming().extraSpinVideosWatched >= 0 && incoming().extraSpinVideosWatched <= 2)) &&
             (!('extraSpinAvailable' in incoming()) || incoming().extraSpinAvailable is bool) &&
             incoming().updatedAt is timestamp;
    }

    function expectedWithdrawalCoins(method, amountRupees) {
      return (method == 'UPI' && amountRupees == 200) ? 33000 :
             (method == 'UPI' && amountRupees == 500) ? 82500 :
             ((method in ['AMAZON_GIFT_CARD', 'GOOGLE_PLAY_GIFT_CARD', 'FLIPKART_GIFT_CARD']) && amountRupees == 150) ? 33000 :
             ((method in ['AMAZON_GIFT_CARD', 'GOOGLE_PLAY_GIFT_CARD', 'FLIPKART_GIFT_CARD']) && amountRupees == 200) ? 44000 :
             ((method in ['AMAZON_GIFT_CARD', 'GOOGLE_PLAY_GIFT_CARD', 'FLIPKART_GIFT_CARD']) && amountRupees == 250) ? 55000 :
             0;
    }

    // Approved user atomically debiting their own wallet when creating a fixed-denomination withdrawal request
    function isAtomicWithdrawalDebitForUser(userId) {
      let oldBalanceCents = ('balanceCents' in existing() && existing().balanceCents is int) ? existing().balanceCents : 0;
      let oldCentsCoins = int((oldBalanceCents * 125) / 100);
      let oldEligibleCoins = ('eligibleCoins' in existing() && existing().eligibleCoins is int && existing().eligibleCoins > oldCentsCoins)
        ? existing().eligibleCoins
        : oldCentsCoins;
      let oldPromoCoins = ('promotionalCoins' in existing() && existing().promotionalCoins is int) ? existing().promotionalCoins : 0;
      let oldBalanceCoins = ('balanceCoins' in existing() && existing().balanceCoins is int) ? existing().balanceCoins : 0;
      let oldTotalCoins = oldBalanceCoins > (oldEligibleCoins + oldPromoCoins)
        ? oldBalanceCoins
        : (oldEligibleCoins + oldPromoCoins);
      let reqId = incoming().lastWithdrawalRequestId;
      let reqPath = /databases/$(database)/documents/withdrawal_requests/$(reqId);
      return request.auth.uid == userId &&
             isApprovedUser(userId) &&
             changedKeys().hasOnly([
               'balanceCoins',
               'eligibleCoins',
               'promotionalCoins',
               'balanceCents',
               'lastWithdrawalRequestId',
               'updatedAt'
             ]) &&
             isNonEmptyString(reqId, 128) &&
             !exists(reqPath) &&
             existsAfter(reqPath) &&
             getAfter(reqPath).data.userId == userId &&
             getAfter(reqPath).data.status == 'SUBMITTED' &&
             getAfter(reqPath).data.coinsDeducted == true &&
             getAfter(reqPath).data.coinsRefunded == false &&
             getAfter(reqPath).data.amountCoins > 0 &&
             oldTotalCoins >= getAfter(reqPath).data.amountCoins &&
             incoming().role == existing().role &&
             incoming().approvalStatus == existing().approvalStatus &&
             incoming().completedTasksCount == existing().completedTasksCount &&
             incoming().balanceCoins == oldTotalCoins - getAfter(reqPath).data.amountCoins &&
             incoming().eligibleCoins == oldEligibleCoins - getAfter(reqPath).data.deductedEligibleCoins &&
             incoming().eligibleCoins >= 0 &&
             incoming().promotionalCoins == oldPromoCoins - getAfter(reqPath).data.deductedPromotionalCoins &&
             incoming().promotionalCoins >= 0 &&
             incoming().balanceCents == oldBalanceCents - getAfter(reqPath).data.deductedBalanceCents &&
             incoming().balanceCents >= 0 &&
             incoming().updatedAt is timestamp;
    }

    // Admin atomically refunding deducted coins once when rejecting a non-terminal withdrawal request
    function isAtomicAdminWithdrawalRefund(userId) {
      let oldBalanceCents = ('balanceCents' in existing() && existing().balanceCents is int) ? existing().balanceCents : 0;
      let oldExplicitEligible = ('eligibleCoins' in existing() && existing().eligibleCoins is int)
        ? existing().eligibleCoins
        : int((oldBalanceCents * 125) / 100);
      let oldPromoCoins = ('promotionalCoins' in existing() && existing().promotionalCoins is int) ? existing().promotionalCoins : 0;
      let oldBalanceCoins = ('balanceCoins' in existing() && existing().balanceCoins is int) ? existing().balanceCoins : 0;
      let reqId = incoming().lastRefundedWithdrawalId;
      let reqPath = /databases/$(database)/documents/withdrawal_requests/$(reqId);
      return isAdmin() &&
             changedKeys().hasOnly([
               'balanceCoins',
               'eligibleCoins',
               'promotionalCoins',
               'balanceCents',
               'lastRefundedWithdrawalId',
               'updatedAt'
             ]) &&
             isNonEmptyString(reqId, 128) &&
             exists(reqPath) &&
             existsAfter(reqPath) &&
             get(reqPath).data.userId == userId &&
             get(reqPath).data.coinsDeducted == true &&
             get(reqPath).data.coinsRefunded == false &&
             !(get(reqPath).data.status in ['COMPLETED', 'REJECTED', 'approved', 'rejected']) &&
             getAfter(reqPath).data.coinsRefunded == true &&
             getAfter(reqPath).data.status == 'REJECTED' &&
             incoming().balanceCoins == oldBalanceCoins + get(reqPath).data.deductedBalanceCoins &&
             incoming().eligibleCoins == oldExplicitEligible + get(reqPath).data.deductedEligibleCoins &&
             incoming().promotionalCoins == oldPromoCoins + get(reqPath).data.deductedPromotionalCoins &&
             incoming().balanceCents == oldBalanceCents + get(reqPath).data.deductedBalanceCents &&
             incoming().updatedAt is timestamp;
    }

    // =========================================================================
    // 3. PUBLIC LEADERBOARD PROJECTION VALIDATION (/leaderboard/{userId})
    // =========================================================================

    // Safe public leaderboard entry containing ONLY non-sensitive public fields.
    // Explicitly forbids `email` and must match the authoritative `/users/{userId}` document.
    function isValidLeaderboardSync(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return hasExactKeys([
               'userId',
               'displayName',
               'balanceCents',
               'completedTasksCount',
               'approvalStatus',
               'updatedAt'
             ]) &&
             !('email' in incoming()) &&
             existsAfter(userPath) &&
             incoming().userId == userId &&
             incoming().displayName == getAfter(userPath).data.displayName &&
             incoming().balanceCents == getAfter(userPath).data.balanceCents &&
             incoming().completedTasksCount == getAfter(userPath).data.completedTasksCount &&
             incoming().approvalStatus == getAfter(userPath).data.approvalStatus &&
             incoming().updatedAt is timestamp;
    }

    // =========================================================================
    // 4. TASK & SUBMISSION VALIDATION (/tasks/{taskId}, /submissions/{submissionId})
    // =========================================================================

    function isAssigneeUpdatedOnTaskCreate(taskId, assignedUid) {
      let userPath = /databases/$(database)/documents/users/$(assignedUid);
      return existsAfter(userPath) &&
             getAfter(userPath).data.assignedTaskId == taskId;
    }

    function isValidAdminTaskCreate(taskId) {
      return isAdmin() &&
             incoming().keys().hasOnly([
               'title',
               'appName',
               'appIconUrl',
               'description',
               'instructions',
               'requiredProof',
               'taskLink',
               'category',
               'rewardCents',
               'rewardCoins',
               'assignedUserId',
               'assignedUserName',
               'assignedUserEmail',
               'status',
               'isActive',
               'proofText',
               'proofImageUrl',
               'proofStoragePath',
               'adminFeedback',
               'createdBy',
               'createdAt',
               'updatedAt'
             ]) &&
             incoming().keys().hasAll([
               'title',
               'description',
               'category',
               'rewardCents',
               'assignedUserId',
               'assignedUserName',
               'assignedUserEmail',
               'status',
               'proofText',
               'proofImageUrl',
               'proofStoragePath',
               'adminFeedback',
               'createdBy',
               'createdAt',
               'updatedAt'
             ]) &&
             isNonEmptyString(incoming().title, 120) &&
             (!('appName' in incoming()) || isOptionalString(incoming().appName, 120)) &&
             (!('appIconUrl' in incoming()) || isValidIconOrImageField(incoming().appIconUrl)) &&
             isNonEmptyString(incoming().description, 2000) &&
             (!('instructions' in incoming()) || isOptionalString(incoming().instructions, 4000)) &&
             (!('requiredProof' in incoming()) || isOptionalString(incoming().requiredProof, 2000)) &&
             (!('taskLink' in incoming()) || isValidHttpsTaskLink(incoming().taskLink)) &&
             isNonEmptyString(incoming().category, 60) &&
             incoming().rewardCents is int &&
             incoming().rewardCents > 0 &&
             incoming().rewardCents <= 10000000 &&
             (!('rewardCoins' in incoming()) || (incoming().rewardCoins is int && incoming().rewardCoins > 0)) &&
             isNonEmptyString(incoming().assignedUserId, 128) &&
             isNonEmptyString(incoming().assignedUserName, 100) &&
             isNonEmptyString(incoming().assignedUserEmail, 254) &&
             incoming().status == 'pending' &&
             (!('isActive' in incoming()) || incoming().isActive == true) &&
             incoming().proofText == '' &&
             incoming().proofImageUrl == '' &&
             incoming().proofStoragePath == '' &&
             incoming().adminFeedback == '' &&
             incoming().createdBy == request.auth.uid &&
             incoming().createdAt is timestamp &&
             incoming().updatedAt is timestamp &&
             isAssigneeUpdatedOnTaskCreate(taskId, incoming().assignedUserId);
    }

    function isTaskReassignmentConsistent(taskId, oldUid, newUid) {
      let newUserPath = /databases/$(database)/documents/users/$(newUid);
      let oldUserPath = /databases/$(database)/documents/users/$(oldUid);
      return existsAfter(newUserPath) &&
             getAfter(newUserPath).data.assignedTaskId == taskId &&
             (
               oldUid == newUid ||
               oldUid == '' ||
               !exists(oldUserPath) ||
               get(oldUserPath).data.assignedTaskId != taskId ||
               getAfter(oldUserPath).data.assignedTaskId != taskId
             );
    }

    function isValidAdminTaskEdit(taskId) {
      return isAdmin() &&
             existing().status == 'pending' &&
             changedKeys().hasOnly([
               'title',
               'appName',
               'appIconUrl',
               'description',
               'instructions',
               'requiredProof',
               'taskLink',
               'category',
               'rewardCents',
               'rewardCoins',
               'assignedUserId',
               'assignedUserName',
               'assignedUserEmail',
               'updatedAt'
             ]) &&
             isNonEmptyString(incoming().title, 120) &&
             (!('appName' in incoming()) || isOptionalString(incoming().appName, 120)) &&
             (!('appIconUrl' in incoming()) || isValidIconOrImageField(incoming().appIconUrl)) &&
             isNonEmptyString(incoming().description, 2000) &&
             (!('instructions' in incoming()) || isOptionalString(incoming().instructions, 4000)) &&
             (!('requiredProof' in incoming()) || isOptionalString(incoming().requiredProof, 2000)) &&
             (!('taskLink' in incoming()) || isValidHttpsTaskLink(incoming().taskLink)) &&
             isNonEmptyString(incoming().category, 60) &&
             incoming().rewardCents is int &&
             incoming().rewardCents > 0 &&
             incoming().rewardCents <= 10000000 &&
             isNonEmptyString(incoming().assignedUserId, 128) &&
             isNonEmptyString(incoming().assignedUserName, 100) &&
             isNonEmptyString(incoming().assignedUserEmail, 254) &&
             incoming().updatedAt is timestamp &&
             isTaskReassignmentConsistent(taskId, existing().assignedUserId, incoming().assignedUserId);
    }

    function isValidAdminTaskActiveToggle() {
      return isAdmin() &&
             changedKeys().hasOnly(['isActive', 'updatedAt']) &&
             incoming().isActive is bool &&
             incoming().updatedAt is timestamp;
    }

    // Approved user submitting proof on an open, active task (legacy single-assignee format)
    function isAtomicTaskSubmissionByAssignee(taskId) {
      let legacySubPath = /databases/$(database)/documents/submissions/$(taskId);
      let multiSubPath = /databases/$(database)/documents/submissions/$(taskId + '_' + request.auth.uid);
      let taskIsActive = !('isActive' in existing()) || existing().isActive == true;
      return isSignedIn() &&
             isApprovedUser(request.auth.uid) &&
             existing().status == 'pending' &&
             taskIsActive &&
             changedKeys().hasOnly([
               'assignedUserId',
               'assignedUserName',
               'assignedUserEmail',
               'status',
               'proofText',
               'proofImageUrl',
               'proofStoragePath',
               'updatedAt'
             ]) &&
             incoming().assignedUserId == request.auth.uid &&
             isNonEmptyString(incoming().assignedUserName, 100) &&
             isNonEmptyString(incoming().assignedUserEmail, 254) &&
             incoming().status == 'submitted' &&
             isNonEmptyString(incoming().proofText, 4000) &&
             isValidProofImageUrl(incoming().proofImageUrl) &&
             isNonEmptyString(incoming().proofStoragePath, 500) &&
             incoming().rewardCents == existing().rewardCents &&
             incoming().updatedAt is timestamp &&
             (existsAfter(legacySubPath) || existsAfter(multiSubPath));
    }

    // Approved user creating the corresponding `/submissions/{submissionId}` record (legacy single-assignee format)
    function isAtomicSubmissionCreate(submissionId) {
      let taskPath = /databases/$(database)/documents/tasks/$(submissionId);
      return isSignedIn() &&
             isApprovedUser(request.auth.uid) &&
             !exists(/databases/$(database)/documents/submissions/$(submissionId)) &&
             exists(taskPath) &&
             existsAfter(taskPath) &&
             get(taskPath).data.status == 'pending' &&
             (!('isActive' in get(taskPath).data) || get(taskPath).data.isActive == true) &&
             incoming().keys().hasOnly([
               'taskId',
               'taskTitle',
               'appName',
               'appIconUrl',
               'rewardCents',
               'rewardCoins',
               'userId',
               'userName',
               'userEmail',
               'proofText',
               'proofImageUrl',
               'proofStoragePath',
               'status',
               'adminFeedback',
               'createdAt',
               'updatedAt'
             ]) &&
             incoming().keys().hasAll([
               'taskId',
               'taskTitle',
               'rewardCents',
               'userId',
               'userName',
               'userEmail',
               'proofText',
               'proofImageUrl',
               'proofStoragePath',
               'status',
               'adminFeedback',
               'createdAt',
               'updatedAt'
             ]) &&
             incoming().taskId == submissionId &&
             incoming().userId == request.auth.uid &&
             isNonEmptyString(incoming().taskTitle, 120) &&
             (!('appName' in incoming()) || isOptionalString(incoming().appName, 120)) &&
             (!('appIconUrl' in incoming()) || isValidIconOrImageField(incoming().appIconUrl)) &&
             incoming().rewardCents == get(taskPath).data.rewardCents &&
             isNonEmptyString(incoming().userName, 100) &&
             isNonEmptyString(incoming().userEmail, 254) &&
             isNonEmptyString(incoming().proofText, 4000) &&
             isValidProofImageUrl(incoming().proofImageUrl) &&
             isNonEmptyString(incoming().proofStoragePath, 500) &&
             incoming().status == 'submitted' &&
             incoming().adminFeedback == '' &&
             incoming().createdAt is timestamp &&
             incoming().updatedAt is timestamp &&
             getAfter(taskPath).data.status == 'submitted' &&
             getAfter(taskPath).data.assignedUserId == request.auth.uid &&
             getAfter(taskPath).data.proofText == incoming().proofText &&
             getAfter(taskPath).data.proofImageUrl == incoming().proofImageUrl &&
             getAfter(taskPath).data.proofStoragePath == incoming().proofStoragePath;
    }

    // Approved user creating a multi-user submission record where submissionId is unique (e.g. ${taskId}_${userId})
    function isMultiUserSubmissionCreate(submissionId) {
      let taskId = incoming().taskId;
      let taskPath = /databases/$(database)/documents/tasks/$(taskId);
      return isSignedIn() &&
             isApprovedUser(request.auth.uid) &&
             !exists(/databases/$(database)/documents/submissions/$(submissionId)) &&
             exists(taskPath) &&
             (!('isActive' in get(taskPath).data) || get(taskPath).data.isActive == true) &&
             incoming().keys().hasOnly([
               'taskId',
               'taskTitle',
               'appName',
               'appIconUrl',
               'rewardCents',
               'rewardCoins',
               'userId',
               'userName',
               'userEmail',
               'proofText',
               'proofImageUrl',
               'proofStoragePath',
               'status',
               'adminFeedback',
               'createdAt',
               'updatedAt'
             ]) &&
             incoming().keys().hasAll([
               'taskId',
               'taskTitle',
               'rewardCents',
               'userId',
               'userName',
               'userEmail',
               'proofText',
               'proofImageUrl',
               'proofStoragePath',
               'status',
               'adminFeedback',
               'createdAt',
               'updatedAt'
             ]) &&
             incoming().userId == request.auth.uid &&
             isNonEmptyString(incoming().taskTitle, 120) &&
             (!('appName' in incoming()) || isOptionalString(incoming().appName, 120)) &&
             (!('appIconUrl' in incoming()) || isValidIconOrImageField(incoming().appIconUrl)) &&
             incoming().rewardCents == get(taskPath).data.rewardCents &&
             isNonEmptyString(incoming().userName, 100) &&
             isNonEmptyString(incoming().userEmail, 254) &&
             isNonEmptyString(incoming().proofText, 4000) &&
             isValidProofImageUrl(incoming().proofImageUrl) &&
             isNonEmptyString(incoming().proofStoragePath, 500) &&
             incoming().status == 'submitted' &&
             incoming().adminFeedback == '' &&
             incoming().createdAt is timestamp &&
             incoming().updatedAt is timestamp;
    }

    function isAdminReviewUserConsistent(submittingUid, rewardCents, newStatus) {
      let userPath = /databases/$(database)/documents/users/$(submittingUid);
      return exists(userPath) &&
             existsAfter(userPath) &&
             (
               (
                 newStatus == 'approved' &&
                 getAfter(userPath).data.balanceCents == get(userPath).data.balanceCents + rewardCents &&
                 getAfter(userPath).data.completedTasksCount == get(userPath).data.completedTasksCount + 1
               ) ||
               (
                 newStatus == 'rejected' &&
                 getAfter(userPath).data.balanceCents == get(userPath).data.balanceCents &&
                 getAfter(userPath).data.completedTasksCount == get(userPath).data.completedTasksCount
               )
             );
    }

    // Admin approving or rejecting a submitted task (legacy single-assignee format)
    function isAtomicAdminTaskReview(taskId) {
      let legacySubPath = /databases/$(database)/documents/submissions/$(taskId);
      let multiSubPath = /databases/$(database)/documents/submissions/$(taskId + '_' + existing().assignedUserId);
      let subPath = existsAfter(multiSubPath) ? multiSubPath : legacySubPath;
      return isAdmin() &&
             existing().status == 'submitted' &&
             exists(subPath) &&
             existsAfter(subPath) &&
             get(subPath).data.status == 'submitted' &&
             changedKeys().hasOnly(['status', 'adminFeedback', 'updatedAt']) &&
             isNonEmptyString(incoming().adminFeedback, 1000) &&
             incoming().updatedAt is timestamp &&
             getAfter(subPath).data.status == incoming().status &&
             getAfter(subPath).data.adminFeedback == incoming().adminFeedback &&
             isAdminReviewUserConsistent(get(subPath).data.userId, existing().rewardCents, incoming().status);
    }

    function isAtomicAdminSubmissionReview(submissionId) {
      let taskPath = /databases/$(database)/documents/tasks/$(submissionId);
      return isAdmin() &&
             existing().status == 'submitted' &&
             exists(taskPath) &&
             existsAfter(taskPath) &&
             get(taskPath).data.status == 'submitted' &&
             changedKeys().hasOnly(['status', 'adminFeedback', 'updatedAt']) &&
             isNonEmptyString(incoming().adminFeedback, 1000) &&
             incoming().updatedAt is timestamp &&
             getAfter(taskPath).data.status == incoming().status &&
             getAfter(taskPath).data.adminFeedback == incoming().adminFeedback &&
             isAdminReviewUserConsistent(existing().userId, get(taskPath).data.rewardCents, incoming().status);
    }

    function isAtomicAdminMultiUserSubmissionReview(submissionId) {
      let submittingUid = existing().userId;
      return isAdmin() &&
             existing().status == 'submitted' &&
             changedKeys().hasOnly(['status', 'adminFeedback', 'updatedAt']) &&
             (incoming().status == 'approved' || incoming().status == 'rejected') &&
             isNonEmptyString(incoming().adminFeedback, 1000) &&
             incoming().updatedAt is timestamp &&
             isAdminReviewUserConsistent(submittingUid, existing().rewardCents, incoming().status);
    }

    // =========================================================================
    // 5. WITHDRAWAL REDEMPTION & TRANSACTION VALIDATION
    // =========================================================================

    function isDenomFlagEnabled(mapObj, key) {
      return !(key in mapObj) || mapObj[key] == true;
    }

    function isMethodConfigAvailable(cfg, method, amountRupees) {
      let key = string(amountRupees);
      return (
        (method == 'UPI' &&
          (!('upiEnabled' in cfg) || cfg.upiEnabled == true) &&
          (!('upiDenominationsEnabled' in cfg) || isDenomFlagEnabled(cfg.upiDenominationsEnabled, key))) ||
        (method == 'AMAZON_GIFT_CARD' &&
          (!('amazonEnabled' in cfg) || cfg.amazonEnabled == true) &&
          (!('amazonDenominationsEnabled' in cfg) || isDenomFlagEnabled(cfg.amazonDenominationsEnabled, key))) ||
        (method == 'GOOGLE_PLAY_GIFT_CARD' &&
          (!('googlePlayEnabled' in cfg) || cfg.googlePlayEnabled == true) &&
          (!('googlePlayDenominationsEnabled' in cfg) || isDenomFlagEnabled(cfg.googlePlayDenominationsEnabled, key))) ||
        (method == 'FLIPKART_GIFT_CARD' &&
          (!('flipkartEnabled' in cfg) || cfg.flipkartEnabled == true) &&
          (!('flipkartDenominationsEnabled' in cfg) || isDenomFlagEnabled(cfg.flipkartDenominationsEnabled, key)))
      );
    }

    function isWithdrawalAvailable(method, amountRupees) {
      let availPath = /databases/$(database)/documents/app_config/withdrawal_availability;
      return !exists(availPath) || isMethodConfigAvailable(get(availPath).data, method, amountRupees);
    }

    function isValidWithdrawalBucketMath(userData, reqCoins) {
      let oldBalanceCents = ('balanceCents' in userData && userData.balanceCents is int) ? userData.balanceCents : 0;
      let oldCentsCoins = int((oldBalanceCents * 125) / 100);
      let oldEligibleCoins = ('eligibleCoins' in userData && userData.eligibleCoins is int && userData.eligibleCoins > oldCentsCoins)
        ? userData.eligibleCoins
        : oldCentsCoins;
      let oldPromoCoins = ('promotionalCoins' in userData && userData.promotionalCoins is int) ? userData.promotionalCoins : 0;
      let expectedDeductEligible = oldEligibleCoins >= reqCoins ? reqCoins : oldEligibleCoins;
      let remainingNeeded = reqCoins - expectedDeductEligible;
      let expectedDeductPromo = oldPromoCoins >= remainingNeeded ? remainingNeeded : oldPromoCoins;
      let expectedMaxCents = int((expectedDeductEligible * 100) / 125);
      let expectedDeductCents = oldBalanceCents >= expectedMaxCents ? expectedMaxCents : oldBalanceCents;
      return incoming().deductedBalanceCoins == reqCoins &&
             incoming().deductedEligibleCoins == expectedDeductEligible &&
             incoming().deductedPromotionalCoins == expectedDeductPromo &&
             incoming().deductedBalanceCents == expectedDeductCents;
    }

    function isValidWithdrawalRedemptionCreate(requestId) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let reqCoins = expectedWithdrawalCoins(incoming().method, incoming().amountRupees);
      let txPath = /databases/$(database)/documents/transactions/$('wd_debit_' + requestId);
      return isSignedIn() &&
             isApprovedUser(request.auth.uid) &&
             incoming().keys().hasOnly([
               'requestId',
               'userId',
               'userName',
               'method',
               'amountRupees',
               'amountCents',
               'amountCoins',
               'upiId',
               'status',
               'statusNote',
               'adminActionBy',
               'paymentReference',
               'giftCode',
               'giftCodeHash',
               'coinsDeducted',
               'coinsRefunded',
               'deductedBalanceCoins',
               'deductedEligibleCoins',
               'deductedPromotionalCoins',
               'deductedBalanceCents',
               'idempotencyKey',
               'isDemo',
               'createdAt',
               'updatedAt'
             ]) &&
             incoming().keys().hasAll([
               'requestId',
               'userId',
               'userName',
               'method',
               'amountRupees',
               'amountCents',
               'amountCoins',
               'upiId',
               'status',
               'statusNote',
               'adminActionBy',
               'paymentReference',
               'giftCode',
               'giftCodeHash',
               'coinsDeducted',
               'coinsRefunded',
               'deductedBalanceCoins',
               'deductedEligibleCoins',
               'deductedPromotionalCoins',
               'deductedBalanceCents',
               'idempotencyKey',
               'isDemo',
               'createdAt',
               'updatedAt'
             ]) &&
             incoming().requestId == requestId &&
             incoming().userId == request.auth.uid &&
             isNonEmptyString(incoming().userName, 100) &&
             incoming().amountRupees is int &&
             incoming().amountCents is int &&
             incoming().amountCoins is int &&
             reqCoins > 0 &&
             incoming().amountCoins == reqCoins &&
             incoming().amountCents == incoming().amountRupees * 100 &&
             isWithdrawalAvailable(incoming().method, incoming().amountRupees) &&
             (
               (incoming().method == 'UPI' && isNonEmptyString(incoming().upiId, 120) && incoming().upiId.matches('^[^\\s@]+@[^\\s@]+$')) ||
               (incoming().method in ['AMAZON_GIFT_CARD', 'GOOGLE_PLAY_GIFT_CARD', 'FLIPKART_GIFT_CARD'] && incoming().upiId == '')
             ) &&
             incoming().status == 'SUBMITTED' &&
             incoming().statusNote == '' &&
             incoming().adminActionBy == '' &&
             incoming().paymentReference == '' &&
             incoming().giftCode == '' &&
             incoming().giftCodeHash == '' &&
             incoming().coinsDeducted == true &&
             incoming().coinsRefunded == false &&
             incoming().isDemo == false &&
             isNonEmptyString(incoming().idempotencyKey, 128) &&
             incoming().idempotencyKey == requestId &&
             incoming().deductedBalanceCoins is int &&
             incoming().deductedEligibleCoins is int &&
             incoming().deductedPromotionalCoins is int &&
             incoming().deductedBalanceCents is int &&
             isValidWithdrawalBucketMath(get(userPath).data, reqCoins) &&
             incoming().createdAt is timestamp &&
             incoming().updatedAt is timestamp &&
             existsAfter(userPath) &&
             (!('lastWithdrawalRequestId' in get(userPath).data) || get(userPath).data.lastWithdrawalRequestId != requestId) &&
             getAfter(userPath).data.lastWithdrawalRequestId == requestId &&
             existsAfter(txPath);
    }

    function isValidAdminWithdrawalUpdate(requestId) {
      let isNonTerminal = !(existing().status in ['COMPLETED', 'REJECTED', 'approved', 'rejected']);
      let userPath = /databases/$(database)/documents/users/$(existing().userId);
      let refundTxPath = /databases/$(database)/documents/transactions/$('wd_refund_' + requestId);
      return isAdmin() &&
             isNonTerminal &&
             incoming().updatedAt is timestamp &&
             (
               // 1. Accept (Under Review) or Mark Processing (monotonic, no-op & coin mutation blocked)
               (
                 (incoming().status == 'UNDER_REVIEW' || incoming().status == 'PROCESSING') &&
                 incoming().status != existing().status &&
                 (existing().status != 'PROCESSING' || incoming().status == 'PROCESSING') &&
                 changedKeys().hasOnly(['status', 'statusNote', 'adminActionBy', 'reviewedAt', 'updatedAt']) &&
                 isOptionalString(incoming().statusNote, 500) &&
                 isNonEmptyString(incoming().adminActionBy, 128) &&
                 incoming().reviewedAt is timestamp
               ) ||
               // 2. Complete Gift Card by delivering a unique non-reusable gift code
               (
                 existing().method in ['AMAZON_GIFT_CARD', 'GOOGLE_PLAY_GIFT_CARD', 'FLIPKART_GIFT_CARD'] &&
                 existing().coinsDeducted == true &&
                 existing().coinsRefunded == false &&
                 (!('giftCode' in existing()) || existing().giftCode == '') &&
                 incoming().status == 'COMPLETED' &&
                 changedKeys().hasOnly(['status', 'statusNote', 'adminActionBy', 'giftCode', 'giftCodeHash', 'giftCodeAssignedAt', 'completedAt', 'updatedAt']) &&
                 isNonEmptyString(incoming().giftCode, 200) &&
                 isNonEmptyString(incoming().giftCodeHash, 128) &&
                 isOptionalString(incoming().statusNote, 500) &&
                 isNonEmptyString(incoming().adminActionBy, 128) &&
                 incoming().giftCodeAssignedAt is timestamp &&
                 incoming().completedAt is timestamp &&
                 !exists(/databases/$(database)/documents/used_gift_codes/$(incoming().giftCodeHash)) &&
                 existsAfter(/databases/$(database)/documents/used_gift_codes/$(incoming().giftCodeHash))
               ) ||
               // 3. Complete UPI payout only after actual manual payment transfer
               (
                 (existing().method == 'UPI' || existing().method == 'UPI ID') &&
                 existing().coinsDeducted == true &&
                 existing().coinsRefunded == false &&
                 incoming().status == 'COMPLETED' &&
                 changedKeys().hasOnly(['status', 'statusNote', 'adminActionBy', 'paymentReference', 'completedAt', 'updatedAt']) &&
                 isOptionalString(incoming().paymentReference, 120) &&
                 isOptionalString(incoming().statusNote, 500) &&
                 isNonEmptyString(incoming().adminActionBy, 128) &&
                 incoming().completedAt is timestamp
               ) ||
               // 4. Reject & Atomically Refund Coins Once
               (
                 incoming().status == 'REJECTED' &&
                 existing().coinsDeducted == true &&
                 existing().coinsRefunded == false &&
                 incoming().coinsRefunded == true &&
                 changedKeys().hasOnly(['status', 'statusNote', 'adminActionBy', 'coinsRefunded', 'rejectedAt', 'updatedAt']) &&
                 isNonEmptyString(incoming().statusNote, 500) &&
                 isNonEmptyString(incoming().adminActionBy, 128) &&
                 incoming().rejectedAt is timestamp &&
                 existsAfter(userPath) &&
                 getAfter(userPath).data.lastRefundedWithdrawalId == requestId &&
                 existsAfter(refundTxPath)
               )
             );
    }

    function isApprovedTaskOrSubmissionForTransaction(refId, userId, amountCents) {
      let taskPath = /databases/$(database)/documents/tasks/$(refId);
      let subPath = /databases/$(database)/documents/submissions/$(refId);
      return (
        (existsAfter(taskPath) &&
         getAfter(taskPath).data.status == 'approved' &&
         getAfter(taskPath).data.assignedUserId == userId &&
         getAfter(taskPath).data.rewardCents == amountCents) ||
        (existsAfter(subPath) &&
         getAfter(subPath).data.status == 'approved' &&
         getAfter(subPath).data.userId == userId &&
         getAfter(subPath).data.rewardCents == amountCents)
      );
    }

    function isValidAdminTaskRewardTransaction() {
      return isAdmin() &&
             incoming().keys().hasOnly([
               'userId',
               'userName',
               'type',
               'title',
               'amountCents',
               'amountCoins',
               'status',
               'referenceId',
               'createdAt'
             ]) &&
             incoming().keys().hasAll([
               'userId',
               'userName',
               'type',
               'title',
               'amountCents',
               'status',
               'referenceId',
               'createdAt'
             ]) &&
             incoming().type == 'TASK_REWARD' &&
             incoming().status == 'CREDITED' &&
             isNonEmptyString(incoming().referenceId, 128) &&
             isNonEmptyString(incoming().userId, 128) &&
             isNonEmptyString(incoming().userName, 100) &&
             isNonEmptyString(incoming().title, 200) &&
             incoming().amountCents is int &&
             incoming().amountCents > 0 &&
             incoming().createdAt is timestamp &&
             isApprovedTaskOrSubmissionForTransaction(incoming().referenceId, incoming().userId, incoming().amountCents);
    }

    function isValidWithdrawalDebitTransaction(transactionId) {
      let reqId = incoming().referenceId;
      let reqPath = /databases/$(database)/documents/withdrawal_requests/$(reqId);
      return isSignedIn() &&
             isApprovedUser(request.auth.uid) &&
             isNonEmptyString(reqId, 128) &&
             transactionId == 'wd_debit_' + reqId &&
             !exists(/databases/$(database)/documents/transactions/$(transactionId)) &&
             incoming().keys().hasOnly([
               'userId',
               'userName',
               'type',
               'title',
               'amountCents',
               'amountCoins',
               'status',
               'referenceId',
               'createdAt'
             ]) &&
             incoming().keys().hasAll([
               'userId',
               'userName',
               'type',
               'title',
               'amountCents',
               'amountCoins',
               'status',
               'referenceId',
               'createdAt'
             ]) &&
             incoming().userId == request.auth.uid &&
             incoming().type == 'WITHDRAWAL_DEBIT' &&
             incoming().status == 'DEBITED' &&
             isNonEmptyString(incoming().userName, 100) &&
             isNonEmptyString(incoming().title, 200) &&
             incoming().amountCents is int &&
             incoming().amountCoins is int &&
             incoming().amountCoins > 0 &&
             incoming().createdAt is timestamp &&
             existsAfter(reqPath) &&
             getAfter(reqPath).data.userId == request.auth.uid &&
             getAfter(reqPath).data.amountCoins == incoming().amountCoins &&
             getAfter(reqPath).data.amountCents == incoming().amountCents;
    }

    function isValidAdminWithdrawalRefundTransaction(transactionId) {
      let reqId = incoming().referenceId;
      let reqPath = /databases/$(database)/documents/withdrawal_requests/$(reqId);
      return isAdmin() &&
             isNonEmptyString(reqId, 128) &&
             transactionId == 'wd_refund_' + reqId &&
             !exists(/databases/$(database)/documents/transactions/$(transactionId)) &&
             incoming().keys().hasOnly([
               'userId',
               'userName',
               'type',
               'title',
               'amountCents',
               'amountCoins',
               'status',
               'referenceId',
               'createdAt'
             ]) &&
             incoming().keys().hasAll([
               'userId',
               'userName',
               'type',
               'title',
               'amountCents',
               'amountCoins',
               'status',
               'referenceId',
               'createdAt'
             ]) &&
             incoming().type == 'WITHDRAWAL_REFUND' &&
             incoming().status == 'REFUNDED' &&
             isNonEmptyString(incoming().userId, 128) &&
             isNonEmptyString(incoming().userName, 100) &&
             isNonEmptyString(incoming().title, 200) &&
             incoming().amountCents is int &&
             incoming().amountCoins is int &&
             incoming().amountCoins > 0 &&
             incoming().createdAt is timestamp &&
             exists(reqPath) &&
             existsAfter(reqPath) &&
             get(reqPath).data.coinsRefunded == false &&
             getAfter(reqPath).data.coinsRefunded == true &&
             getAfter(reqPath).data.status == 'REJECTED' &&
             getAfter(reqPath).data.userId == incoming().userId &&
             getAfter(reqPath).data.amountCoins == incoming().amountCoins;
    }

    function isValidAtomicPromotionalCoinTransaction() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let oldPromo = ('promotionalCoins' in get(userPath).data && get(userPath).data.promotionalCoins is int)
        ? get(userPath).data.promotionalCoins
        : 0;
      return isSignedIn() &&
             isApprovedUser(request.auth.uid) &&
             incoming().keys().hasOnly([
               'userId',
               'userName',
               'type',
               'title',
               'amountCents',
               'amountCoins',
               'status',
               'referenceId',
               'createdAt'
             ]) &&
             incoming().keys().hasAll([
               'userId',
               'userName',
               'type',
               'title',
               'amountCents',
               'amountCoins',
               'status',
               'referenceId',
               'createdAt'
             ]) &&
             incoming().userId == request.auth.uid &&
             (incoming().type == 'DAILY_CHECKIN' || incoming().type == 'WATCH_EARN' || incoming().type == 'SPIN_EARN') &&
             incoming().status == 'CREDITED' &&
             isNonEmptyString(incoming().referenceId, 128) &&
             isNonEmptyString(incoming().userName, 100) &&
             isNonEmptyString(incoming().title, 200) &&
             incoming().amountCoins is int &&
             incoming().amountCoins >= 1 &&
             incoming().amountCoins <= 1000 &&
             incoming().createdAt is timestamp &&
             existsAfter(userPath) &&
             getAfter(userPath).data.promotionalCoins == oldPromo + incoming().amountCoins;
    }

    function isValidAdminDoc(adminId) {
      return hasExactKeys(['userId', 'email', 'createdAt']) &&
             incoming().userId == adminId &&
             isNonEmptyString(incoming().email, 254) &&
             incoming().createdAt is timestamp;
    }

    function isUserClearedOnTaskDelete(assignedUid, taskId) {
      let userPath = /databases/$(database)/documents/users/$(assignedUid);
      return !exists(userPath) ||
             get(userPath).data.assignedTaskId != taskId ||
             getAfter(userPath).data.assignedTaskId != taskId;
    }

    function isConsistentTaskDelete(taskId) {
      return isAdmin() && (
        existing().status != 'pending' ||
        existing().assignedUserId == '' ||
        isUserClearedOnTaskDelete(existing().assignedUserId, taskId)
      );
    }

    // =========================================================================
    // 6. COLLECTION SECURITY RULES
    // =========================================================================

    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isBootstrappedAdmin() && isValidAdminDoc(adminId);
      allow delete: if isBootstrappedAdmin();
    }

    match /users/{userId} {
      // Users can read only their own profile; only Admin can read or list all user profiles.
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUserCreate(userId);
      allow update: if isSignedIn() && (
        isValidOwnerDisplayNameUpdate(userId) ||
        isBootstrapAdminSelfInit(userId) ||
        isValidAdminUserStatusUpdate() ||
        isValidAdminDisplayNameUpdate() ||
        isAtomicTaskAssignmentToUser(userId) ||
        isAtomicTaskUnassignmentFromUser(userId) ||
        isAtomicTaskApprovalForUser(userId) ||
        isAtomicPromotionalCoinOrSpinUpdate(userId) ||
        isAtomicWithdrawalDebitForUser(userId) ||
        isAtomicAdminWithdrawalRefund(userId)
      );
      allow delete: if false;

      // Daily check-in records: only allowed when atomically paired with a promotionalCoins update
      match /check_ins/{dateKey} {
        allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isSignedIn() &&
                      request.auth.uid == userId &&
                      isApprovedUser(userId) &&
                      ('rewardCoins' in incoming()) &&
                      incoming().rewardCoins is int &&
                      incoming().rewardCoins >= 1 &&
                      incoming().rewardCoins <= 1000 &&
                      getAfter(/databases/$(database)/documents/users/$(userId)).data.lastCheckInDate == dateKey;
        allow update, delete: if false;
      }

      // Per-user watch stats: only allowed when atomically paired with a promotionalCoins update
      match /watch_stats/{dateKey} {
        allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create, update: if isSignedIn() &&
                              request.auth.uid == userId &&
                              isApprovedUser(userId) &&
                              ('totalEarnedCoins' in incoming()) &&
                              incoming().totalEarnedCoins is int &&
                              incoming().videosWatched is int &&
                              incoming().videosWatched >= 1 &&
                              incoming().videosWatched <= 50 &&
                              getAfter(/databases/$(database)/documents/users/$(userId)).data.promotionalCoins > 0;
        allow delete: if false;
      }

      // Per-user spin sessions & watch ad sessions
      match /spin_sessions/{sessionId} {
        allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create, update: if isSignedIn() && request.auth.uid == userId && isApprovedUser(userId);
        allow delete: if false;
      }

      match /ad_sessions/{sessionId} {
        allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create, update: if isSignedIn() && request.auth.uid == userId && isApprovedUser(userId);
        allow delete: if false;
      }

      // In-app notifications
      match /notifications/{notificationId} {
        allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isSignedIn() &&
                      (request.auth.uid == userId || isAdmin()) &&
                      (!('userId' in incoming()) || incoming().userId == userId);
        allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && changedKeys().hasOnly(['isRead']);
        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Safe public leaderboard projection containing ONLY non-sensitive public fields (no email).
    match /leaderboard/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() &&
                            (request.auth.uid == userId || isAdmin()) &&
                            isValidLeaderboardSync(userId);
      allow delete: if isAdmin();
    }

    // Transactions:
    // - Task reward transactions require atomic Admin task approval.
    // - Withdrawal debit & refund transactions require atomic withdrawal creation / rejection.
    // - Promotional Coin transactions (DAILY_CHECKIN, WATCH_EARN, SPIN_EARN) require atomic promotionalCoins credit.
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (
        isValidAdminTaskRewardTransaction() ||
        isValidWithdrawalDebitTransaction(transactionId) ||
        isValidAdminWithdrawalRefundTransaction(transactionId) ||
        isValidAtomicPromotionalCoinTransaction()
      );
      allow update, delete: if false;
    }

    // Legacy reward_sessions collection remains locked down to Admin SDK only.
    match /reward_sessions/{sessionId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    // Top-level watch_stats: only allowed when atomically paired with a promotionalCoins update
    match /watch_stats/{statId} {
      allow get: if isSignedIn() && (
        statId.matches('^' + request.auth.uid + '_.*') ||
        (resource != null && resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() &&
                            isApprovedUser(request.auth.uid) &&
                            incoming().userId == request.auth.uid &&
                            ('totalEarnedCoins' in incoming()) &&
                            incoming().totalEarnedCoins is int &&
                            incoming().videosWatched is int &&
                            incoming().videosWatched >= 1 &&
                            incoming().videosWatched <= 50 &&
                            getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.promotionalCoins > 0;
      allow delete: if false;
    }

    match /tasks/{taskId} {
      allow get, list: if isSignedIn();
      allow create: if isValidAdminTaskCreate(taskId);
      allow update: if isValidAdminTaskEdit(taskId) ||
                    isValidAdminTaskActiveToggle() ||
                    isAtomicTaskSubmissionByAssignee(taskId) ||
                    isAtomicAdminTaskReview(taskId);
      allow delete: if isConsistentTaskDelete(taskId);
    }

    match /submissions/{submissionId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAtomicSubmissionCreate(submissionId) || isMultiUserSubmissionCreate(submissionId);
      allow update: if isAtomicAdminSubmissionReview(submissionId) || isAtomicAdminMultiUserSubmissionReview(submissionId);
      allow delete: if false;
    }

    match /withdrawal_requests/{requestId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidWithdrawalRedemptionCreate(requestId);
      allow update: if isValidAdminWithdrawalUpdate(requestId);
      allow delete: if false;
    }

    // Unique Gift Code Lock Registry (prevents duplicate gift code issuance across all requests)
    match /used_gift_codes/{codeHash} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() &&
                    !exists(/databases/$(database)/documents/used_gift_codes/$(codeHash)) &&
                    hasExactKeys(['codeHash', 'requestId', 'method', 'amountRupees', 'assignedBy', 'assignedAt']) &&
                    incoming().codeHash == codeHash &&
                    isNonEmptyString(incoming().requestId, 128) &&
                    isNonEmptyString(incoming().method, 64) &&
                    incoming().amountRupees is int &&
                    incoming().amountRupees > 0 &&
                    isNonEmptyString(incoming().assignedBy, 128) &&
                    incoming().assignedAt is timestamp &&
                    existsAfter(/databases/$(database)/documents/withdrawal_requests/$(incoming().requestId)) &&
                    getAfter(/databases/$(database)/documents/withdrawal_requests/$(incoming().requestId)).data.giftCodeHash == codeHash &&
                    getAfter(/databases/$(database)/documents/withdrawal_requests/$(incoming().requestId)).data.status == 'COMPLETED';
      allow update, delete: if false;
    }

    // Global Withdrawal & Gift Card Availability Config
    match /app_config/{docId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Admin Notifications Queue (notifies Admin when new withdrawal requests arrive)
    match /admin_notifications/{notifId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn() &&
                    incoming().userId == request.auth.uid &&
                    isNonEmptyString(incoming().referenceId, 128) &&
                    notifId == 'admin_wd_' + incoming().referenceId &&
                    !exists(/databases/$(database)/documents/admin_notifications/$(notifId)) &&
                    !exists(/databases/$(database)/documents/withdrawal_requests/$(incoming().referenceId)) &&
                    isNonEmptyString(incoming().title, 160) &&
                    isNonEmptyString(incoming().body, 600) &&
                    incoming().isRead == false &&
                    existsAfter(/databases/$(database)/documents/withdrawal_requests/$(incoming().referenceId)) &&
                    getAfter(/databases/$(database)/documents/withdrawal_requests/$(incoming().referenceId)).data.userId == request.auth.uid;
      allow update: if isAdmin() && changedKeys().hasOnly(['isRead']);
      allow delete: if isAdmin();
    }

    // Client & Partner Campaigns
    match /campaigns/{campaignId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // User Support Tickets / Inquiries
    match /support_tickets/{ticketId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
                    request.resource.data.userId == request.auth.uid &&
                    hasExactKeys(['userId', 'userName', 'userEmail', 'category', 'subject', 'message', 'status', 'createdAt']) &&
                    isNonEmptyString(request.resource.data.subject, 200) &&
                    isNonEmptyString(request.resource.data.message, 4000) &&
                    request.resource.data.status == 'OPEN' &&
                    request.resource.data.createdAt is timestamp;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
