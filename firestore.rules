rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Explicit Denial for Withdrawals / Payouts (Completely disabled)
    match /withdrawals/{withdrawalId} {
      allow read, write: if false;
    }

    // 2. Core Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Requires all three:
    // 1. Signed-in user
    // 2. Token email matches expectedEmail
    // 3. request.auth.token.email_verified == true
    function hasVerifiedTokenEmail(expectedEmail) {
      return isSignedIn() &&
             ('email' in request.auth.token) &&
             request.auth.token.email is string &&
             request.auth.token.email == expectedEmail &&
             ('email_verified' in request.auth.token) &&
             request.auth.token.email_verified == true;
    }

    // Cross-document state helpers (Pre-operation vs. Post-batch/transaction state)
    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function getUserAfterData(uid) {
      return getAfter(/databases/$(database)/documents/users/$(uid)).data;
    }

    function getTaskData(taskId) {
      return get(/databases/$(database)/documents/tasks/$(taskId)).data;
    }

    function getTaskAfterData(taskId) {
      return getAfter(/databases/$(database)/documents/tasks/$(taskId)).data;
    }

    function getSubmissionData(subId) {
      return get(/databases/$(database)/documents/submissions/$(subId)).data;
    }

    function getSubmissionAfterData(subId) {
      return getAfter(/databases/$(database)/documents/submissions/$(subId)).data;
    }

    // Root Bootstrap Owner Check (Verified token email ONLY)
    // Only the bootstrap owner can create, update, or delete /admins records.
    function isVerifiedAdminEmail() {
      return hasVerifiedTokenEmail('dasakash24059@gmail.com');
    }

    // Trusted Admin Check:
    // Evaluates against server-controlled custom claims, verified bootstrap owner email,
    // or the bootstrap-owner-controlled /admins/{uid} registry.
    // NEVER trusts client-editable /users/{uid}.role.
    function isAdmin() {
      return isSignedIn() && (
        (('admin' in request.auth.token) && request.auth.token.admin == true) ||
        isVerifiedAdminEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Checks that a user profile exists and has been approved by an admin
    function isApprovedUser(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
             getUserData(uid).approvalStatus == 'approved';
    }

    // Atomic Batch Validator for Task Approval & Reward Credit:
    // Verifies via get() and getAfter() that within the exact same atomic batch:
    // - Both /tasks/{taskId} and /submissions/{taskId} exist before and after the batch
    // - Pre-batch and post-batch task.assignedUserId both equal userId
    // - Pre-batch and post-batch submission.userId both equal userId
    // - Pre-batch and post-batch submission.taskId both equal taskId
    // - Pre-batch task status and pre-batch submission status are both 'submitted'
    // - Post-batch task status and post-batch submission status are both 'approved'
    // - Task and submission rewardCents match and remain unaltered in the batch
    // - User balanceCents increases by exactly task.rewardCents
    // - User completedTasksCount increases by exactly 1
    function isAtomicTaskApprovalForUser(taskId, userId, beforeBalance, afterBalance, beforeCount, afterCount) {
      let taskBefore = getTaskData(taskId);
      let taskAfter = getTaskAfterData(taskId);
      let subBefore = getSubmissionData(taskId);
      let subAfter = getSubmissionAfterData(taskId);
      return isValidId(taskId) &&
             exists(/databases/$(database)/documents/tasks/$(taskId)) &&
             exists(/databases/$(database)/documents/submissions/$(taskId)) &&
             existsAfter(/databases/$(database)/documents/tasks/$(taskId)) &&
             existsAfter(/databases/$(database)/documents/submissions/$(taskId)) &&
             taskBefore.assignedUserId == userId &&
             taskAfter.assignedUserId == userId &&
             subBefore.userId == userId &&
             subAfter.userId == userId &&
             subBefore.taskId == taskId &&
             subAfter.taskId == taskId &&
             taskBefore.status == 'submitted' &&
             subBefore.status == 'submitted' &&
             taskAfter.status == 'approved' &&
             subAfter.status == 'approved' &&
             taskAfter.adminFeedback == subAfter.adminFeedback &&
             taskBefore.rewardCents == subBefore.rewardCents &&
             taskAfter.rewardCents == taskBefore.rewardCents &&
             subAfter.rewardCents == subBefore.rewardCents &&
             afterBalance == beforeBalance + taskBefore.rewardCents &&
             afterCount == beforeCount + 1;
    }

    // Validates that an admin update to /users/{userId}.assignedTaskId is atomically consistent
    // with /tasks/{assignedTaskId}.assignedUserId:
    // - If clearing a previously non-empty assignedTaskId, the previous task must either no longer
    //   exist after the batch or be assigned to a different user after the batch.
    // - If setting a non-empty assignedTaskId, that task must exist after the batch and have
    //   assignedUserId == userId.
    function isConsistentUserTaskAssignment(userId) {
      let prevTaskId = existing().assignedTaskId;
      let nextTaskId = incoming().assignedTaskId;
      return !('assignedTaskId' in incoming().diff(existing()).affectedKeys()) ||
             (
               (nextTaskId == '' || nextTaskId == null) &&
               (
                 !('assignedTaskId' in existing()) ||
                 prevTaskId == '' ||
                 prevTaskId == null ||
                 !existsAfter(/databases/$(database)/documents/tasks/$(prevTaskId)) ||
                 getTaskAfterData(prevTaskId).assignedUserId != userId
               )
             ) ||
             (
               isValidId(nextTaskId) &&
               existsAfter(/databases/$(database)/documents/tasks/$(nextTaskId)) &&
               getTaskAfterData(nextTaskId).assignedUserId == userId
             );
    }

    // 3. Schema Validation Blueprints (Anti-Update-Gap)
    function isValidUserProfile(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.role is string && (data.role == 'user' || data.role == 'admin') &&
             data.approvalStatus is string && (data.approvalStatus == 'approved' || data.approvalStatus == 'pending' || data.approvalStatus == 'suspended') &&
             data.balanceCents is int && data.balanceCents >= 0 && data.balanceCents <= 1000000000 &&
             data.completedTasksCount is int && data.completedTasksCount >= 0 && data.completedTasksCount <= 1000000 &&
             (!('assignedTaskId' in data) || data.assignedTaskId == null || (data.assignedTaskId is string && data.assignedTaskId.size() <= 128)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTask(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 2000 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
             data.rewardCents is int && data.rewardCents >= 1 && data.rewardCents <= 10000000 &&
             data.assignedUserId is string && isValidId(data.assignedUserId) &&
             data.assignedUserName is string && data.assignedUserName.size() >= 1 && data.assignedUserName.size() <= 100 &&
             data.assignedUserEmail is string && data.assignedUserEmail.size() >= 3 && data.assignedUserEmail.size() <= 254 &&
             data.status is string && (data.status == 'pending' || data.status == 'submitted' || data.status == 'approved' || data.status == 'rejected') &&
             data.proofText is string && data.proofText.size() <= 4000 &&
             data.adminFeedback is string && data.adminFeedback.size() <= 1000 &&
             data.createdBy is string && isValidId(data.createdBy) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSubmission(data) {
      return data.taskId is string && isValidId(data.taskId) &&
             data.taskTitle is string && data.taskTitle.size() >= 1 && data.taskTitle.size() <= 120 &&
             data.rewardCents is int && data.rewardCents >= 1 && data.rewardCents <= 10000000 &&
             data.userId is string && isValidId(data.userId) &&
             data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100 &&
             data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 254 &&
             data.proofText is string && data.proofText.size() >= 1 && data.proofText.size() <= 4000 &&
             data.status is string && (data.status == 'submitted' || data.status == 'approved' || data.status == 'rejected') &&
             data.adminFeedback is string && data.adminFeedback.size() <= 1000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAdminRecord(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidTaskProofSubmissionTransition(taskId) {
      let subAfter = getSubmissionAfterData(taskId);
      return request.auth.uid == existing().assignedUserId &&
             existing().status == 'pending' &&
             incoming().status == 'submitted' &&
             incoming().proofText.size() >= 1 &&
             incoming().diff(existing()).affectedKeys().hasOnly(['status', 'proofText', 'updatedAt']) &&
             isApprovedUser(request.auth.uid) &&
             !exists(/databases/$(database)/documents/submissions/$(taskId)) &&
             existsAfter(/databases/$(database)/documents/submissions/$(taskId)) &&
             subAfter.taskId == taskId &&
             subAfter.userId == request.auth.uid &&
             subAfter.status == 'submitted' &&
             subAfter.proofText == incoming().proofText &&
             subAfter.rewardCents == existing().rewardCents;
    }

    function isValidTaskEditOrReassignTransition(taskId) {
      let newAssignee = incoming().assignedUserId;
      let oldAssignee = existing().assignedUserId;
      return existing().status == 'pending' &&
             incoming().status == 'pending' &&
             incoming().proofText == '' &&
             incoming().adminFeedback == '' &&
             incoming().diff(existing()).affectedKeys().hasOnly([
               'title', 'description', 'category', 'rewardCents',
               'assignedUserId', 'assignedUserName', 'assignedUserEmail', 'updatedAt'
             ]) &&
             exists(/databases/$(database)/documents/users/$(newAssignee)) &&
             getUserAfterData(newAssignee).assignedTaskId == taskId &&
             (
               newAssignee == oldAssignee ||
               !exists(/databases/$(database)/documents/users/$(oldAssignee)) ||
               getUserData(oldAssignee).assignedTaskId != taskId ||
               getUserAfterData(oldAssignee).assignedTaskId != taskId
             );
    }

    function isValidTaskApprovalTransition(taskId) {
      let assignedUid = existing().assignedUserId;
      let userBefore = getUserData(assignedUid);
      let userAfter = getUserAfterData(assignedUid);
      return existing().status == 'submitted' &&
             incoming().status == 'approved' &&
             incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminFeedback', 'updatedAt']) &&
             exists(/databases/$(database)/documents/users/$(assignedUid)) &&
             userAfter.assignedTaskId == taskId &&
             userAfter.balanceCents == userBefore.balanceCents + existing().rewardCents &&
             userAfter.completedTasksCount == userBefore.completedTasksCount + 1;
    }

    function isValidTaskRejectionTransition(taskId) {
      let assignedUid = existing().assignedUserId;
      let subBefore = getSubmissionData(taskId);
      let subAfter = getSubmissionAfterData(taskId);
      let userBefore = getUserData(assignedUid);
      let userAfter = getUserAfterData(assignedUid);
      return existing().status == 'submitted' &&
             incoming().status == 'rejected' &&
             incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminFeedback', 'updatedAt']) &&
             exists(/databases/$(database)/documents/submissions/$(taskId)) &&
             subBefore.status == 'submitted' &&
             subAfter.status == 'rejected' &&
             subAfter.adminFeedback == incoming().adminFeedback &&
             (
               !exists(/databases/$(database)/documents/users/$(assignedUid)) ||
               (
                 userAfter.balanceCents == userBefore.balanceCents &&
                 userAfter.completedTasksCount == userBefore.completedTasksCount
               )
             );
    }

    // 4. Collection Rules: /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'email', 'displayName', 'role',
                         'approvalStatus', 'balanceCents', 'completedTasksCount',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'email', 'displayName', 'role',
                         'approvalStatus', 'balanceCents', 'completedTasksCount',
                         'assignedTaskId', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == userId &&
                       (
                         // Path 1: Standard user self-registration
                         // Must use verified Auth token email, start as 'user' with 'pending' approval and 0 balance
                         (
                           request.auth.uid == userId &&
                           hasVerifiedTokenEmail(incoming().email) &&
                           incoming().role == 'user' &&
                           incoming().approvalStatus == 'pending' &&
                           incoming().balanceCents == 0 &&
                           incoming().completedTasksCount == 0 &&
                           (!('assignedTaskId' in incoming()) || incoming().assignedTaskId == null || incoming().assignedTaskId == '')
                         ) ||
                         // Path 2: Verified admin creating a user profile, or bootstrap owner initializing their own admin profile
                         (
                           isAdmin() &&
                           incoming().balanceCents == 0 &&
                           incoming().completedTasksCount == 0 &&
                           (!('assignedTaskId' in incoming()) || incoming().assignedTaskId == null || incoming().assignedTaskId == '') &&
                           (
                             incoming().role == 'user' ||
                             (request.auth.uid == userId && isVerifiedAdminEmail() && hasVerifiedTokenEmail(incoming().email))
                           )
                         )
                       );

      allow update: if isSignedIn() &&
                       isValidUserProfile(incoming()) &&
                       (
                         // Path 1: Standard user updating ONLY their own displayName
                         (
                           request.auth.uid == userId &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
                         ) ||
                         (
                           isAdmin() &&
                           (
                             // Path 2: Admin updating user approvalStatus, assignedTaskId, or displayName
                             // Cannot alter balanceCents or completedTasksCount here.
                             // Only the bootstrap owner can change a user's role field.
                             (
                               (incoming().role == existing().role || isVerifiedAdminEmail()) &&
                               incoming().diff(existing()).affectedKeys().hasOnly([
                                 'displayName', 'role', 'approvalStatus', 'assignedTaskId', 'updatedAt'
                               ]) &&
                               isConsistentUserTaskAssignment(userId)
                             ) ||
                             // Path 3: Atomic reward credit by an Admin ONLY as part of the exact same batch
                             // that approves both the corresponding /tasks/{taskId} and /submissions/{taskId}.
                             (
                               incoming().diff(existing()).affectedKeys().hasAll(['balanceCents', 'completedTasksCount']) &&
                               incoming().diff(existing()).affectedKeys().hasOnly([
                                 'balanceCents', 'completedTasksCount', 'assignedTaskId', 'updatedAt'
                               ]) &&
                               ('assignedTaskId' in incoming()) &&
                               isAtomicTaskApprovalForUser(
                                 incoming().assignedTaskId,
                                 userId,
                                 existing().balanceCents,
                                 incoming().balanceCents,
                                 existing().completedTasksCount,
                                 incoming().completedTasksCount
                               )
                             )
                           )
                         )
                       );

      allow delete: if isSignedIn() && isValidId(userId) && isVerifiedAdminEmail();
    }

    // 5. Collection Rules: /tasks/{taskId}
    match /tasks/{taskId} {
      allow get: if isSignedIn() && isValidId(taskId);

      allow list: if isSignedIn();

      // CREATE: Only admins can create tasks; must start in 'pending' state and atomically update assignee's assignedTaskId
      allow create: if isSignedIn() &&
                       isValidId(taskId) &&
                       incoming().keys().hasAll([
                         'title', 'description', 'category', 'rewardCents',
                         'assignedUserId', 'assignedUserName', 'assignedUserEmail',
                         'status', 'proofText', 'adminFeedback', 'createdBy',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'title', 'description', 'category', 'rewardCents',
                         'assignedUserId', 'assignedUserName', 'assignedUserEmail',
                         'status', 'proofText', 'adminFeedback', 'createdBy',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidTask(incoming()) &&
                       incoming().createdBy == request.auth.uid &&
                       incoming().status == 'pending' &&
                       incoming().proofText == '' &&
                       incoming().adminFeedback == '' &&
                       isAdmin() &&
                       exists(/databases/$(database)/documents/users/$(incoming().assignedUserId)) &&
                       getUserAfterData(incoming().assignedUserId).assignedTaskId == taskId;

      // UPDATE: Strict State Machine & Atomic Cross-Document Consistency
      allow update: if isSignedIn() &&
                       isValidId(taskId) &&
                       isValidTask(incoming()) &&
                       (
                         // Transition 1: Assigned & approved user submits text proof ('pending' -> 'submitted')
                         isValidTaskProofSubmissionTransition(taskId) ||
                         // Transition 2-4: Admin operations
                         (
                           isAdmin() &&
                           (
                             // Transition 2: Admin edits or reassigns task ONLY while task is still 'pending'
                             isValidTaskEditOrReassignTransition(taskId) ||
                             // Transition 3: Admin approves a 'submitted' task ('submitted' -> 'approved')
                             isValidTaskApprovalTransition(taskId) ||
                             // Transition 4: Admin rejects a 'submitted' task ('submitted' -> 'rejected')
                             isValidTaskRejectionTransition(taskId)
                           )
                         )
                       );

      // DELETE: Admins can only delete tasks that are still 'pending'
      allow delete: if isSignedIn() &&
                       isValidId(taskId) &&
                       isAdmin() &&
                       existing().status == 'pending' &&
                       (
                         !exists(/databases/$(database)/documents/users/$(existing().assignedUserId)) ||
                         getUserData(existing().assignedUserId).assignedTaskId != taskId ||
                         getUserAfterData(existing().assignedUserId).assignedTaskId != taskId
                       );
    }

    // 6. Collection Rules: /submissions/{submissionId}
    match /submissions/{submissionId} {
      allow get: if isSignedIn() &&
                    isValidId(submissionId) &&
                    (resource == null || existing().userId == request.auth.uid || isAdmin());

      allow list: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid || isAdmin());

      // CREATE: Must happen atomically with /tasks/{taskId} transitioning from 'pending' -> 'submitted'
      allow create: if isSignedIn() &&
                       isValidId(submissionId) &&
                       incoming().keys().hasAll([
                         'taskId', 'taskTitle', 'rewardCents',
                         'userId', 'userName', 'userEmail',
                         'proofText', 'status', 'adminFeedback',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'taskId', 'taskTitle', 'rewardCents',
                         'userId', 'userName', 'userEmail',
                         'proofText', 'status', 'adminFeedback',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidSubmission(incoming()) &&
                       submissionId == incoming().taskId &&
                       incoming().userId == request.auth.uid &&
                       isApprovedUser(request.auth.uid) &&
                       hasVerifiedTokenEmail(incoming().userEmail) &&
                       incoming().status == 'submitted' &&
                       incoming().adminFeedback == '' &&
                       exists(/databases/$(database)/documents/tasks/$(submissionId)) &&
                       getTaskData(submissionId).assignedUserId == request.auth.uid &&
                       getTaskAfterData(submissionId).assignedUserId == request.auth.uid &&
                       getTaskData(submissionId).status == 'pending' &&
                       incoming().rewardCents == getTaskData(submissionId).rewardCents &&
                       incoming().taskTitle == getTaskData(submissionId).title &&
                       getTaskAfterData(submissionId).status == 'submitted' &&
                       getTaskAfterData(submissionId).proofText == incoming().proofText;

      // UPDATE: Terminal State Machine ('submitted' -> 'approved' | 'rejected' ONLY)
      // Must happen atomically with the parent /tasks/{submissionId} status transition
      allow update: if isSignedIn() &&
                       isValidId(submissionId) &&
                       isValidSubmission(incoming()) &&
                       isAdmin() &&
                       existing().status == 'submitted' &&
                       (incoming().status == 'approved' || incoming().status == 'rejected') &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status', 'adminFeedback', 'updatedAt'
                       ]) &&
                       exists(/databases/$(database)/documents/tasks/$(submissionId)) &&
                       getTaskData(submissionId).status == 'submitted' &&
                       getTaskAfterData(submissionId).status == incoming().status &&
                       getTaskAfterData(submissionId).adminFeedback == incoming().adminFeedback &&
                       getTaskAfterData(submissionId).assignedUserId == existing().userId;

      allow delete: if false;
    }

    // 7. Collection Rules: /admins/{adminId}
    // Strictly restricted to the verified bootstrap owner email (isVerifiedAdminEmail)
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
                       isValidId(adminId) &&
                       incoming().keys().hasAll(['userId', 'email', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'createdAt']) &&
                       isValidAdminRecord(incoming()) &&
                       incoming().userId == adminId &&
                       isVerifiedAdminEmail();
      allow update: if isSignedIn() &&
                       isValidId(adminId) &&
                       isValidAdminRecord(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isVerifiedAdminEmail() &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email']);
      allow delete: if isSignedIn() && isValidId(adminId) && isVerifiedAdminEmail();
    }
  }
}
